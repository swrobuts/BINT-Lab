      <aliases enabled='yes' />
      <column caption='Gesamtumsatz' datatype='real' name='[Calculation_3034561919254528]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Sales])' />
      </column>
      <column caption='Umsatz West' datatype='real' name='[Calculation_3034561919774721]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Region] = &quot;West&quot; THEN [Sales] END)' />
      </column>
      <column caption='Anteil am Gesamtumsatz (LOD)' datatype='real' name='[Calculation_3034561919840258]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Sales]) / MIN({ FIXED : SUM([Sales]) })' />
      </column>
      <column caption='Anteil an der Ansicht (Tabellenberechnung)' datatype='real' name='[Calculation_3034561919909891]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Sales]) / TOTAL(SUM([Sales]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Umsatz Vorjahr' datatype='real' name='[Calculation_3034561920106500]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOOKUP(SUM([Sales]), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Wachstum gegenüber Vorjahr' datatype='real' name='[Calculation_3034561920208901]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Sales]) - LOOKUP(SUM([Sales]), -1)) / LOOKUP(SUM([Sales]), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Rang nach Umsatz' datatype='integer' name='[Calculation_3034561920262150]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(SUM([Sales]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Umsatz je Kunde (LOD)' datatype='real' name='[Calculation_3034561920319495]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Customer ID] : SUM([Sales]) }' />
      </column>
      <column caption='Erstbestellung je Kunde (LOD)' datatype='date' name='[Calculation_3034561920348168]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [Customer ID] : MIN([Order Date]) }' />
      </column>
      <column caption='Durchschnittlicher Bestellwert' datatype='real' name='[Calculation_3034561920405513]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Sales]) / COUNTD([Order ID])' />
      </column>
