-- 1. Kalendertabelle anlegen (Modellierung -> Neue Tabelle)
--    Zeitintelligenz braucht eine lueckenlose, als Datumstabelle
--    markierte Tabelle. Auto-Datum/Uhrzeit reicht dafuer nicht.

Datum =
VAR _min = MIN(Orders[Order Date])
VAR _max = MAX(Orders[Order Date])
RETURN
ADDCOLUMNS(
    CALENDAR(DATE(YEAR(_min), 1, 1), DATE(YEAR(_max), 12, 31)),
    "Jahr",        YEAR([Date]),
    "Monatsnr",    MONTH([Date]),
    "Monat",       FORMAT([Date], "MMM"),
    "Quartal",     "Q" & QUARTER([Date])
)

-- 2. Danach im Menueband: Tabellentools -> Als Datumstabelle markieren
--    -> Spalte [Date] waehlen. Anschliessend im Modell eine 1:n-Beziehung
--    von Datum[Date] zu Orders[Order Date] ziehen.

-- 3. Grundlegende Measures

Umsatz =
SUM(Orders[Sales])

Bestellungen =
DISTINCTCOUNT(Orders[Order ID])

Positionen =
COUNTROWS(Orders)

Avg_Bestellwert =
DIVIDE([Umsatz], [Bestellungen], 0)

-- Zeitintelligenz laeuft ueber die Datumstabelle, nicht ueber Orders:
Umsatz_VJ =
CALCULATE([Umsatz], SAMEPERIODLASTYEAR(Datum[Date]))

YoY_Wachstum =
DIVIDE([Umsatz] - [Umsatz_VJ], [Umsatz_VJ], 0) * 100

-- Sollwerte zur Kontrolle:
-- Umsatz 2.261.536,78 | Bestellungen 4.922 | Positionen 9.800
-- Avg_Bestellwert 459,48
-- 2017: 600.192,55 | 2018: 722.052,02 | YoY_Wachstum 2018 ~ 20,3 %

-- Hinweis: Der Datensatz enthaelt keine Kosten- oder Gewinnspalte.
-- Deckungsbeitrags-Measures wie Gewinn oder Marge lassen sich damit
-- nicht bilden; sie brauchen die Vollversion des Superstore-Datensatzes.

-- 4. Kacheln, Minisaeulen, Monatslinie und Jahresfilter (Schritt 4 und 5)
--    Der Slicer liegt auf der Spalte Jahr. Die Kacheln zeigen das
--    Bezugsjahr (das juengste gewaehlte Jahr, ohne Auswahl 2018) und den
--    Vergleich zum Jahr davor. Muster fuer Umsatz; Bestellungen,
--    Positionen und Avg_Bestellwert genauso.

Jahr = YEAR(Orders[Order Date])            -- Spaltentools -> Neue Spalte

Bezugsjahr =
MAX(Orders[Jahr])

Umsatz Bezugsjahr =
VAR j = [Bezugsjahr]
RETURN CALCULATE([Umsatz], FILTER(ALL(Orders[Jahr]), Orders[Jahr] = j))

Umsatz Vorjahr =
VAR j = [Bezugsjahr]
RETURN CALCULATE([Umsatz], FILTER(ALL(Orders[Jahr]), Orders[Jahr] = j - 1))

Umsatz Veraenderung =
VAR a = [Umsatz Bezugsjahr]
VAR v = [Umsatz Vorjahr]
VAR d = DIVIDE(a - v, v)
RETURN IF(ISBLANK(v), "kein Vorjahr im Datensatz",
    IF(d >= 0, "+", "-") & FORMAT(ABS(d) * 100, "0.0") & " % zum Vorjahr")

Umsatz Farbe =                              -- Kartenfarbe per Feldwert
IF(ISBLANK([Umsatz Vorjahr]) || [Umsatz Bezugsjahr] >= [Umsatz Vorjahr], "#1E3A8A", "#B23B1E")

Umsatz Titel =
"UMSATZ " & [Bezugsjahr]

-- Minisaeulen: eigene Tabelle Jahre ohne Beziehung, damit die Achse
-- alle vier Jahre behaelt, auch wenn der Slicer auf ein Jahr steht
-- (Modellierung -> Neue Tabelle):
Jahre =
ADDCOLUMNS(DISTINCT(SELECTCOLUMNS(Orders, "Jahr", Orders[Jahr])),
    "Jahr kurz", "'" & RIGHT(FORMAT([Jahr], "0"), 2))

-- Gestapeltes Saeulendiagramm: X-Achse Jahre[Jahr kurz], zwei Reihen,
-- Vorjahre hellgrau, Bezugsjahr in der Akzentfarbe
Umsatz Vorjahre =
VAR j = [Bezugsjahr]
VAR y = MAX(Jahre[Jahr])
RETURN IF(y <> j, CALCULATE([Umsatz], REMOVEFILTERS(Orders[Jahr]), Orders[Jahr] = y))

Umsatz Aktuell =
VAR j = [Bezugsjahr]
VAR y = MAX(Jahre[Jahr])
RETURN IF(y = j, CALCULATE([Umsatz], REMOVEFILTERS(Orders[Jahr]), Orders[Jahr] = y))

-- Monatslinie: grauer Punkt am Jahreshoch, letzter Wert rot
-- (Monatsbeginn = DATE(YEAR([Order Date]), MONTH([Order Date]), 1) als Spalte)
Saisonpunkte =
VAR y = YEAR(MAX(Orders[Order Date]))
VAR cur = [Umsatz]
VAR mx = MAXX(FILTER(ALL(Orders[Monatsbeginn]), YEAR(Orders[Monatsbeginn]) = y),
    VAR mb = Orders[Monatsbeginn] RETURN CALCULATE([Umsatz], REMOVEFILTERS(), Orders[Monatsbeginn] = mb))
RETURN IF(cur = mx && MAX(Orders[Order Date]) < DATE(2018, 12, 1), cur)

Letzter Monat =
IF(MAX(Orders[Order Date]) >= DATE(2018, 12, 1), [Umsatz])

-- Untertitel mit dem gewaehlten Zeitraum
Zeitraum =
VAR mn = MIN(Orders[Jahr])
VAR mx = MAX(Orders[Jahr])
RETURN IF(mn = mx, FORMAT(mn, "0"), FORMAT(mn, "0") & "-" & FORMAT(mx, "0"))

Untertitel Umsatz =
"Umsatz in US-Dollar, " & [Zeitraum]
